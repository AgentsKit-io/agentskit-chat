{
  "name": "@agentskit/chat-react-native",
  "version": "0.2.5",
  "description": "React Native renderer for AgentsKit Chat.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AgentsKit-io/agentskit-chat.git",
    "directory": "packages/react-native"
  },
  "homepage": "https://chat.agentskit.io/docs",
  "bugs": {
    "url": "https://github.com/AgentsKit-io/agentskit-chat/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.tsx --format esm,cjs --dts --clean --external react --external react-native --external @agentskit/react-native",
    "lint": "tsc --noEmit",
    "test": "pnpm --filter @agentskit/chat build && vitest run --config ../../vitest.coverage.ts --environment happy-dom --coverage"
  },
  "dependencies": {
    "@agentskit/chat": "workspace:*"
  },
  "peerDependencies": {
    "@agentskit/react-native": ">=0.4.4 <1",
    "react": ">=18",
    "react-native": "*"
  },
  "devDependencies": {
    "@agentskit/core": "^1.15.0",
    "@agentskit/react-native": ">=0.5.10 <1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "happy-dom": "^21.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-native": "^0.88.0",
    "tsup": "^8.5.1"
  },
  "publishConfig": {},
  "private": true
}
