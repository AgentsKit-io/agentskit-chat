{
  "name": "@agentskit/chat-server",
  "private": true,
  "version": "0.2.4",
  "description": "Web-standard server handler for AgentsKit Chat applications.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AgentsKit-io/agentskit-chat.git",
    "directory": "packages/server"
  },
  "homepage": "https://chat.agentskit.io/docs",
  "bugs": {
    "url": "https://github.com/AgentsKit-io/agentskit-chat/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "lint": "tsc --noEmit",
    "test": "pnpm --filter @agentskit/chat build && pnpm --filter @agentskit/chat-protocol build && vitest run --config ../../vitest.coverage.ts --coverage"
  },
  "dependencies": {
    "@agentskit/chat": "workspace:*",
    "@agentskit/chat-protocol": "workspace:*",
    "@agentskit/net": "^0.2.0",
    "aws4fetch": "1.0.20"
  },
  "peerDependencies": {
    "@agentskit/core": "^1.15.0",
    "@agentskit/observability": ">=0.13.0 <1"
  },
  "devDependencies": {
    "@agentskit/core": "^1.15.0",
    "tsup": "^8.5.1",
    "@agentskit/observability": "^0.13.0"
  },
  "publishConfig": {},
  "peerDependenciesMeta": {
    "@agentskit/observability": {
      "optional": true
    }
  }
}
