{
  "schemaVersion": 1,
  "project": "agentskit-chat",
  "root": "..",
  "profile": "strict",
  "contract": {
    "intent": "Inspect, improve, and verify AgentsKit Chat documentation, knowledge surfaces, and real application artifacts against the current repository structure using Doc Bridge.",
    "outcomes": [
      {
        "id": "repository-artifact",
        "statement": "The current repository artifact passes its existing quality, lint, build, conformance, bundle, and test gates.",
        "checks": ["lint", "build", "tests", "conformance", "bundle-budget"]
      },
      {
        "id": "documentation",
        "statement": "Human and agent documentation is indexed, quality-checked, current, and consistent with the repository's public package surfaces.",
        "checks": ["docs-bridge-doctor", "docs-bridge-gate", "docs-reference", "readme-standard", "docs-diff-check"]
      },
      {
        "id": "knowledge-bridge",
        "statement": "Doc Bridge discovers the repository, compares documented and structural knowledge, and produces an inspectable architecture and evidence report.",
        "checks": ["docs-bridge-index", "bridge-discovery", "bridge-report", "agent-retrieval"]
      },
      {
        "id": "documentation-audit",
        "statement": "Documentation quality and documentation-to-structure gaps are measured with current evidence.",
        "checks": ["documentation-audit"]
      },
      {
        "id": "http-artifact",
        "statement": "The real chat server HTTP artifact accepts valid requests, rejects invalid boundaries, persists and resumes sessions, streams responses, and recovers from timeout and persistence errors.",
        "checks": ["server-http-contract"]
      },
      {
        "id": "cli-artifact",
        "statement": "The real chat CLI package exposes its documented command surface and generated-project flows.",
        "checks": ["cli-real-flow"]
      },
      {
        "id": "report-ui",
        "statement": "The generated Doc Bridge report is exercised in a real browser across responsive viewports and themes and awaits human visual approval.",
        "checks": ["report-ui"]
      },
      {
        "id": "docs-ui",
        "statement": "The documentation application is exercised in a real browser for navigation, assistant interaction, deterministic behavior, responsive layout, and accessibility.",
        "checks": ["docs-e2e"]
      }
    ]
  },
  "surfaces": {
    "logic": true,
    "endpoint": { "required": true, "reason": "The repository contains a published chat server HTTP handler and documentation API routes; real request flows are in scope." },
    "database": { "required": false, "reason": "No database adapter or database-backed persistence is present in the repository; session persistence is supplied through an injected storage contract." },
    "cli": true,
    "mcp": { "required": false, "reason": "The repository consumes Doc Bridge tooling but does not publish or own an MCP server runtime." },
    "ui": true,
    "docs": true
  },
