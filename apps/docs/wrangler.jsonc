{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Cloudflare Workers deployment of the docs site via OpenNext (@opennextjs/cloudflare).
  // Build + deploy from apps/docs: pnpm cf:deploy. Vercel keeps using `next build` unchanged.
  "name": "agentskit-chat-docs",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "agentskit-chat-docs" }
  ],
  "kv_namespaces": [
    // Route-handler / prerender cache (OpenNext incremental cache).
    { "binding": "NEXT_INC_CACHE_KV", "id": "ca9d10aca2cb4fef9c8d05e036eb96a0" }
  ],
  "observability": { "enabled": true }
}
